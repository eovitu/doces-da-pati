# Configuração do Firebase Web (projeto doces-da-pati).
#
# Copie para .env.local no desenvolvimento e cadastre as MESMAS variáveis na
# Vercel (Project Settings → Environment Variables) marcando Production,
# Preview e Development. Sem elas o Firebase não inicializa e o login do
# /admin falha, mesmo com usuário e senha corretos.
#
# Os valores estão no Console do Firebase → Configurações do projeto → Seus
# apps → Configuração do SDK. NÃO são segredos: quem protege os dados são as
# regras do Firestore e do Storage.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=doces-da-pati.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=doces-da-pati
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# A vitrine pública lê os produtos de src/data/produtos-seed.ts enquanto isto
# for diferente de "true".
NEXT_PUBLIC_USA_FIREBASE=false
