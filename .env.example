# Configuração do Firebase Web (projeto doces-da-pati).
#
# Copie para .env.local no desenvolvimento e cadastre as MESMAS variáveis na
# Vercel (Project Settings → Environment Variables) marcando Production,
# Preview e Development. Sem elas o Firebase não inicializa e o login do
# /admin falha, mesmo com usuário e senha corretos.
#
# Os valores estão no Console do Firebase → Configurações do projeto → Seus
# apps → Configuração do SDK. NÃO são segredos: quem protege os dados são as
# regras do Firestore e do Storage.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=doces-da-pati.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=doces-da-pati
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# "true" = a vitrine e o admin leem/escrevem no Firestore (fonte de verdade
# desde a área administrativa). "false" = usa src/data/produtos-seed.ts, só
# para rodar o site sem nenhuma configuração de Firebase.
NEXT_PUBLIC_USA_FIREBASE=true

# Google Analytics 4 e verificação do Search Console. São identificadores
# públicos, não secrets. Configure somente em Production na Vercel para não
# misturar acessos de Preview/Development com visitantes reais.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
