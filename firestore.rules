rules_version = '2';

// Regras de segurança do Firestore — modelo completo em docs/ESPECIFICACAO.md.
//
// - produtos, categorias, loja/info, entrega/config: leitura pública (é uma
//   vitrine), escrita só de quem tem um documento em admins/{uid} — ou seja,
//   só a Patricia autenticada, nunca qualquer usuário logado.
// - pedidos: qualquer cliente (mesmo anônimo) pode CRIAR um pedido bem
//   formado; ler, alterar ou apagar exige ser admin. Nada além de criar é
//   liberado ao cliente.
// - admins: nunca acessível pelo cliente, nem para leitura. É gerenciado
//   manualmente pelo console/CLI ao criar um usuário novo.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /produtos/{produtoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categorias/{categoriaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /loja/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /entrega/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    match /pedidos/{pedidoId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly([
          "itens", "cliente", "entrega", "formaPagamento", "observacoes", "total", "criadoEm", "status"
        ]) &&
        request.resource.data.itens is list &&
        request.resource.data.itens.size() > 0 &&
        request.resource.data.cliente.keys().hasOnly(["nome", "telefone"]) &&
        request.resource.data.cliente.nome is string &&
        request.resource.data.cliente.nome.size() > 0 &&
        request.resource.data.cliente.telefone is string &&
        request.resource.data.cliente.telefone.size() > 0 &&
        request.resource.data.entrega.tipo in ["retirada", "entrega"] &&
        request.resource.data.formaPagamento in ["pix", "dinheiro", "cartao"] &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        request.resource.data.status == "novo"
      );
    }
  }
}
